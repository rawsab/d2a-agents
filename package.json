{
  "name": "d2a-agents",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "pnpm --filter @d2a/server dev",
    "dev:extension": "pnpm --filter @d2a/extension dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "test": "vitest run",
    "test:e2e": "D2A_PORT=7831 D2A_OUT_DIR=dist-e2e pnpm --filter @d2a/extension build && playwright test",
    "fixtures": "tsx fixtures/server.ts",
    "fixtures:workflow": "tsx fixtures/workflow.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.9.0",
  "dependencies": {
    "@d2a/shared": "workspace:*"
  }
}
